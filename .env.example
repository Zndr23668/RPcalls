# Copy to .env.local for local development.
# Use the Supabase Project URL and publishable key from the project's Connect dialog.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Optional TURN server settings for more reliable connections behind strict NATs/firewalls.
# Comma-separated if your provider supports several TURN URLs.
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=